{
    "name": "Qiskit Quantum Dev Env for QAMP 2025",
    "image": "mcr.microsoft.com/vscode/devcontainers/python:3.12",
    "customizations": {
      "vscode": {
        "extensions": [
            "ms-python.python",
            "ms-toolsai.jupyter",
            "mechatroner.rainbow-csv",
            "charliermarsh.ruff",
            "ms-python.mypy-type-checker"
        ]
      }
    },
    "features": {
      "ghcr.io/devcontainers-extra/features/poetry:2": {},
      "ghcr.io/nils-geistmann/devcontainers-features/zsh:0":  {}
    },
    "postCreateCommand": "cd enhanced-quantum-backend-selector && poetry install --with dev,docs && poetry run pre-commit install"
  }
